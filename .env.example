# ApexDrive — variables de entorno. Copiar a .env (nunca commitear el .env real).
# Ver lib/env.ts para validación con Zod.

# Base de datos (Fase 1: requerida para migrate/seed; la app arranca sin ella en modo degradado)
DATABASE_URL="postgresql://apex:apex@localhost:5432/apexdrive?schema=public"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Auth.js: AUTH_SECRET requerido para iniciar sesión
AUTH_SECRET=""
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Usuarios demo del seed (SOLO dev local, jamás en repo ni producción)
DEMO_ADMIN_PASSWORD=""
DEMO_USER_PASSWORD=""

# Correo SMTP para recuperación de contraseña (Fase 2).
# Sin SMTP: en dev el enlace se loguea; en producción la acción responde 503 honesto.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="ApexDrive <no-reply@apexdrive.mx>"

# Storage R2 (Fase 8 — dejar vacío hasta entonces)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="apexdrive-media"
R2_PUBLIC_URL=""
